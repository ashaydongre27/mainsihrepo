# ==============================================================================
# JOBLEX - Environment Configuration & API Keys
# Ministry of Ayush / All India Institute of Ayurveda (AIIA) | Problem ID: 26044
# 
# Instructions:
# Paste your API keys and configuration values directly after the '=' sign.
# All values below are currently empty and ready for your production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# RESOURCE / API: Google Gemini Generative AI (LangChain & LangGraph Orchestrated)
# Provider: Google AI Studio
# Portal / Resource URL: https://aistudio.google.com/app/apikey
# Used By: Zulu AI Companion, Resume Competency Analyzer, Curriculum Audit
# Architecture: LangGraph automatically routes requests to Primary key first,
#               and seamlessly fails over to Backup key on quota exhaustion/rate limits.
# ------------------------------------------------------------------------------
# Primary Google Gemini API Key:
GEMINI_API_KEY=
GOOGLE_API_KEY_MAIN=

# Backup Google Gemini API Key (Failover fallback):
GEMINI_API_KEY_BACKUP=
GOOGLE_API_KEY_BACKUP=

# ------------------------------------------------------------------------------
# RESOURCE / API: Supabase (PostgreSQL Database, Auth, Realtime & Storage)
# Provider: Supabase Cloud
# Portal / Resource URL: https://supabase.com/dashboard/project/_/settings/api
# Used By: User Profiles, Multi-Role Auth, Database Tables, Applications Pipeline
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ------------------------------------------------------------------------------
# RESOURCE / API: Node.js Express Application Server
# Provider: Localhost / Cloud Hosting (e.g., Render, Railway, AWS, DigitalOcean)
# Defaults when empty: PORT=5000, HOST=0.0.0.0, NODE_ENV=production, CORS_ORIGIN=*
# ------------------------------------------------------------------------------
PORT=
HOST=
NODE_ENV=
CORS_ORIGIN=

# ------------------------------------------------------------------------------
# RESOURCE / API: Ministry of Ayush & AIIA Institutional Metadata
# Provider: Smart India Hackathon (SIH 2026) / National Education Policy (NEP-2020)
# Defaults when empty: 26044 / All India Institute of Ayurveda
# ------------------------------------------------------------------------------
PROBLEM_STATEMENT_ID=
ORGANIZATION_NAME=
PORTAL_TITLE=



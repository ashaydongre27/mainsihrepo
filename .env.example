# ------------------------------------------------------------
# 1. Google Gemini AI Configuration (REQUIRED FOR LIVE AI)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# Paste your key below (replace the placeholder):
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------
# 2. Server Configuration
# ------------------------------------------------------------
PORT=5000
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGIN=*

# ------------------------------------------------------------
# 3. Supabase Authentication & PostgreSQL (OPTIONAL)
# Get your credentials from: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------
# 4. Institutional Metadata & Accreditation
# ------------------------------------------------------------
PROBLEM_STATEMENT_ID=26044
ORGANIZATION_NAME=All India Institute of Ayurveda (AIIA), New Delhi
PORTAL_TITLE=JOBLEX Academia-Industry Bridge


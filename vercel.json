{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/auth",
      "dest": "/auth.html"
    },
    {
      "src": "/student",
      "dest": "/student.html"
    },
    {
      "src": "/academy",
      "dest": "/academy.html"
    },
    {
      "src": "/industry",
      "dest": "/industry.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
